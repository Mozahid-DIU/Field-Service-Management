NODE_ENV=development
PORT=5000

# Neon / any PostgreSQL connection string
DATABASE_URL=postgresql://USER:PASSWORD@HOST/fixflow?sslmode=require

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=replace-with-a-long-random-string-of-at-least-32-chars
JWT_REFRESH_SECRET=replace-with-another-long-random-string-of-32-chars
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES_DAYS=7
BCRYPT_SALT_ROUNDS=10

FRONTEND_URL=http://localhost:3000
# Extra comma-separated origins (optional)
CORS_ORIGINS=

# Google OAuth Web Client ID (Google Cloud Console -> Credentials)
GOOGLE_CLIENT_ID=

# bKash Tokenized Checkout (sandbox)
BKASH_BASE_URL=https://tokenized.sandbox.bka.sh/v1.2.0-beta
BKASH_USERNAME=
BKASH_PASSWORD=
BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_CALLBACK_URL=http://localhost:5000/api/v1/payments/bkash/callback

# Optional: Upstash / any Redis URL
REDIS_URL=

# Optional: Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Seed
SEED_ADMIN_EMAIL=admin@fixflow.com
SEED_ADMIN_PASSWORD=Admin@12345
SEED_DEFAULT_PASSWORD=Password@123

# Proxies in front of the API: 1 = Render only, 2 = Vercel rewrite + Render
TRUST_PROXY_HOPS=1
