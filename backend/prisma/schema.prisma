// FixFlow — Field Service Management
// Models (the "M" in MVC). Business rules live in src/modules/*/*.service.ts

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────── Enums ───────────────────────────────

enum Role {
  CUSTOMER
  TECHNICIAN
  ADMIN
}

enum UserStatus {
  ACTIVE
  BLOCKED
}

enum AuthProvider {
  CREDENTIALS
  GOOGLE
}

enum WorkOrderStatus {
  PENDING
  APPROVED
  REJECTED
  ASSIGNED
  EN_ROUTE
  IN_PROGRESS
  COMPLETED
  PAID
  CANCELLED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum InvoiceStatus {
  UNPAID
  PAID
  VOID
}

enum PaymentProvider {
  BKASH
}

enum PaymentStatus {
  INITIATED
  SUCCESS
  FAILED
  CANCELLED
}

// ─────────────────────────────── Users ───────────────────────────────

model User {
  id        String       @id @default(uuid())
  name      String       @db.VarChar(100)
  email     String       @unique @db.VarChar(255)
  password  String? // null for Google-only accounts
  phone     String?      @db.VarChar(20)
  avatarUrl String?
  role      Role         @default(CUSTOMER)
  status    UserStatus   @default(ACTIVE)
  provider  AuthProvider @default(CREDENTIALS)
  googleId  String?      @unique
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  deletedAt DateTime?

  technicianProfile TechnicianProfile?
  customerOrders    WorkOrder[]        @relation("CustomerWorkOrders")
  technicianOrders  WorkOrder[]        @relation("TechnicianWorkOrders")
  payments          Payment[]
  feedbackGiven     Feedback[]         @relation("FeedbackByCustomer")
  feedbackReceived  Feedback[]         @relation("FeedbackForTechnician")
  auditLogs         AuditLog[]
  refreshTokens     RefreshToken[]

  @@index([role])
  @@index([status])
  @@index([deletedAt])
}

model TechnicianProfile {
  id          String   @id @default(uuid())
  userId      String   @unique
  bio         String?  @db.VarChar(500)
  isAvailable Boolean  @default(true)
  avgRating   Decimal  @default(0) @db.Decimal(3, 2)
  ratingCount Int      @default(0)
  totalJobs   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user   User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  skills ServiceCategory[] @relation("TechnicianSkills")

  @@index([isAvailable])
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ─────────────────────────────── Catalog ───────────────────────────────

model ServiceCategory {
  id          String    @id @default(uuid())
  name        String    @unique @db.VarChar(100)
  description String?   @db.VarChar(500)
  basePrice   Decimal   @db.Decimal(10, 2)
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  workOrders  WorkOrder[]
  technicians TechnicianProfile[] @relation("TechnicianSkills")

  @@index([isActive, deletedAt])
}

// ─────────────────────────────── Work orders ───────────────────────────────

model WorkOrder {
  id             String          @id @default(uuid())
  code           String          @unique @db.VarChar(30)
  customerId     String
  technicianId   String?
  categoryId     String
  title          String          @db.VarChar(150)
  description    String          @db.VarChar(2000)
  address        String          @db.VarChar(300)
  priority       Priority        @default(MEDIUM)
  status         WorkOrderStatus @default(PENDING)
  preferredDate  DateTime?
  scheduledStart DateTime?
  scheduledEnd   DateTime?
  images         String[]        @default([])
  adminNote      String?         @db.VarChar(500)
  cancelReason   String?         @db.VarChar(500)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  deletedAt      DateTime?

  customer   User            @relation("CustomerWorkOrders", fields: [customerId], references: [id])
  technician User?           @relation("TechnicianWorkOrders", fields: [technicianId], references: [id])
  category   ServiceCategory @relation(fields: [categoryId], references: [id])
  report     ServiceReport?
  invoice    Invoice?
  feedback   Feedback?

  @@index([status])
  @@index([customerId, status])
  @@index([technicianId, scheduledStart, scheduledEnd])
  @@index([categoryId])
  @@index([createdAt])
  @@index([deletedAt])
}

model ServiceReport {
  id           String   @id @default(uuid())
  workOrderId  String   @unique
  workDone     String   @db.VarChar(2000)
  partsUsed    Json     @default("[]")
  partsCost    Decimal  @default(0) @db.Decimal(10, 2)
  laborMinutes Int
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  workOrder WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
}

// ─────────────────────────────── Billing ───────────────────────────────

model Invoice {
  id          String        @id @default(uuid())
  invoiceNo   String        @unique @db.VarChar(30)
  workOrderId String        @unique
  serviceFee  Decimal       @db.Decimal(10, 2)
  partsCost   Decimal       @db.Decimal(10, 2)
  total       Decimal       @db.Decimal(10, 2)
  status      InvoiceStatus @default(UNPAID)
  issuedAt    DateTime      @default(now())
  paidAt      DateTime?
  updatedAt   DateTime      @updatedAt

  workOrder WorkOrder @relation(fields: [workOrderId], references: [id])
  payments  Payment[]

  @@index([status])
}

model Payment {
  id             String          @id @default(uuid())
  invoiceId      String
  userId         String
  amount         Decimal         @db.Decimal(10, 2)
  provider       PaymentProvider @default(BKASH)
  status         PaymentStatus   @default(INITIATED)
  bkashPaymentId String?         @unique
  trxId          String?         @unique
  payerAccount   String?         @db.VarChar(20)
  failureReason  String?         @db.VarChar(300)
  rawResponse    Json?
  paidAt         DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  invoice Invoice @relation(fields: [invoiceId], references: [id])
  user    User    @relation(fields: [userId], references: [id])

  @@index([invoiceId])
  @@index([userId, createdAt])
  @@index([status])
}

model Feedback {
  id           String   @id @default(uuid())
  workOrderId  String   @unique
  customerId   String
  technicianId String
  rating       Int // 1..5 — enforced by DB CHECK constraint + Zod
  comment      String?  @db.VarChar(1000)
  createdAt    DateTime @default(now())

  workOrder  WorkOrder @relation(fields: [workOrderId], references: [id])
  customer   User      @relation("FeedbackByCustomer", fields: [customerId], references: [id])
  technician User      @relation("FeedbackForTechnician", fields: [technicianId], references: [id])

  @@index([technicianId, createdAt])
}

// ─────────────────────────────── Audit ───────────────────────────────

model AuditLog {
  id        String   @id @default(uuid())
  actorId   String? // null = system (e.g. payment callback)
  action    String   @db.VarChar(60)
  entity    String   @db.VarChar(40)
  entityId  String
  before    Json?
  after     Json?
  ip        String?  @db.VarChar(64)
  createdAt DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id])

  @@index([entity, entityId])
  @@index([actorId])
  @@index([action])
  @@index([createdAt])
}
